use v6.d;
use lib 'lib';
use Test;
use BDD::Behave;
use BDD::Behave::Playwright;
use WWW::Playwright;

plan 23;

my $playwright = WWW::Playwright.start;
my $browser    = $playwright.launch;
my $context    = $browser.new-context;
my $page       = $context.new-page;

$page.goto(fixture-url('specs/fixtures/hello.html'));

sub passes(&matcher --> Bool) {
  my $ok = True;
  try { matcher(); CATCH { default { $ok = False } } }
  $ok;
}

ok passes({ expect($page.locator('#greeting')).to.be-visible }),
   'be-visible passes for a visible element';

ok passes({ expect($page.locator('#status')).to.be-hidden }),
   'be-hidden passes for a hidden element';

ok passes({ expect($page.locator('#name')).to.be-enabled }),
   'be-enabled passes for an enabled input';

ok passes({ expect($page.locator('#locked')).to.be-disabled }),
   'be-disabled passes for a disabled input';

ok passes({ expect($page.locator('#agree')).to.be-checked }),
   'be-checked passes for a checked checkbox';

ok passes({ expect($page.locator('#greeting')).to.have-text('Hello, world') }),
   'have-text passes when the text matches';

$page.locator('#name').fill('Ada');
ok passes({ expect($page.locator('#name')).to.have-value('Ada') }),
   'have-value passes after filling an input';

ok passes({ expect($page.locator('#name')).to.have-attribute('type', 'text') }),
   'have-attribute passes when the attribute matches';

ok passes({ expect($page.locator('button')).to.have-count(2) }),
   'have-count passes for the expected number of matches';

ok passes({ expect($page).to.have-css('#greeting') }),
   'have-css passes when the page has the selector';

ok passes({ expect($page).to.have-title('Hello') }),
   'have-title passes when the document title matches';

ok passes({ expect($page).to.have-current-path('specs/fixtures/hello.html'.IO.absolute) }),
   'have-current-path matches the path of the current URL';

ok passes({ expect($page).to.have-current-path(fixture-url('specs/fixtures/hello.html'), url => True) }),
   'have-current-path matches the full URL with the url option';

$page.locator('#go-async').click;
ok passes({ expect($page.locator('#async-status')).to.be-visible }),
   'awaits an element revealed asynchronously';

ok passes({ expect($page.locator('#status')).not.to.be-visible(timeout => 0.3) }),
   'be-visible negates for a hidden element';

sub failure-message-of(&matcher --> Str) {
  capture-failures(&matcher).head.message;
}

like failure-message-of({ expect($page.locator('p.missing')).to.have-text('anything', timeout => 0.3) }),
     /'to have text anything, but text was ""' $/,
     'have-text fails with the empty text when the locator matches no element';

like failure-message-of({ expect($page.locator('input.missing')).to.have-value('Ada', timeout => 0.3) }),
     /'to have value Ada, but value was ""' $/,
     'have-value fails with the empty value when the locator matches no element';

like failure-message-of({ expect($page.locator('input.missing')).to.have-attribute('type', 'text', timeout => 0.3) }),
     /'to have attribute "type" text, but the attribute was missing' $/,
     'have-attribute fails with a missing attribute when the locator matches no element';

like failure-message-of({ expect($page.locator('#greeting')).to.have-attribute('alt', 'Grace Hopper', timeout => 0.3) }),
     /'to have attribute "alt" Grace Hopper, but the attribute was missing' $/,
     'have-attribute fails with a missing attribute when the element lacks the attribute';

like failure-message-of({ expect($page.locator('#name')).to.have-attribute('type', 'checkbox', timeout => 0.3) }),
     /'to have attribute "type" checkbox, but it was "text"' $/,
     'have-attribute fails with the actual value when the attribute has a different value';

like failure-message-of({ expect($page).to.have-title('Companies', timeout => 0.3) }),
     /'to have title "Companies", but title was "Hello"' $/,
     'have-title fails with the quoted expected title when the page has a different title';

like failure-message-of({ expect($page).to.have-title(/Companies/, timeout => 0.3) }),
     /'to have title /Companies/, but title was "Hello"' $/,
     'have-title fails with the expected pattern for a regex when the page has a different title';

like failure-message-of({ expect($page).to.have-current-path('/companies', timeout => 0.3) }),
     /'to have current path "/companies", but path was "' .+ '"' $/,
     'have-current-path fails with the quoted expected path when the page has a different current path';

$context.close;
$browser.close;
$playwright.stop;
